{
  "manifest_version": 3,
  "name": "Sahibinden Araç Analiz",
  "version": "1.1",
  "description": "Araç ilanlarında boya/değişen/lokal, tramer kaydı, risk puanı ve yerel fiyat geçmişini gösterir.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.sahibinden.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.sahibinden.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
