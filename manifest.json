{
  "manifest_version": 3,
  "name": "Sahibinden Araç Analiz",
  "version": "1.1",
  "description": "Araç ilanlarında boya/değişen/lokal ve fiyat geçmişini gösterir.",
  "permissions": [],
  "host_permissions": [
    "*://*.sahibinden.com/*",
    "https://api.ourdomain.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.sahibinden.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
