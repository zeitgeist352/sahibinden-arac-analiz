{
  "manifest_version": 3,
  "name": "Sahibinden Araç Analiz",
  "version": "7.0",
  "description": "Araç ilanlarında boya/değişen/lokal bilgisini listede gösterir.",
  "permissions": [],
  "host_permissions": ["*://*.sahibinden.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.sahibinden.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
